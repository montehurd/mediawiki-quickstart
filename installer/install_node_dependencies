#!/bin/bash

source "/var/local/common/utility.sh"

set -eu

install_node_dependencies() {
  # The formatter is the last command in this pipeline and always exits 0, so
  # the pipeline's own status cannot detect a failure. Read the real exit code
  # from PIPESTATUS immediately after the pipeline
  /var/local/installer/configure_npm_workspaces 2>&1 | verboseOrDotPerLine "Hoisting all skin/extension Node dependency satisfaction to MW core, if needed"
  if [ "${PIPESTATUS[0]}" -ne 0 ]; then
    reportStepFailure "Failed to configure MW core 'package.json' to use NPM workspaces wildcard paths for skins/extensions. Exiting"
    return 1
  fi

  if ! [ -f "package.json" ]; then
    echo "Expected 'package.json' not found in '$(pwd)'"
    return 1
  fi

  npm install --legacy-peer-deps --foreground-scripts 2>&1 | verboseOrDotPerLine "Npm install"
  if [ "${PIPESTATUS[0]}" -ne 0 ]; then
    reportStepFailure "NPM install failed. Exiting"
    return 1
  fi
  return 0
}

if [[ "$0" == "${BASH_SOURCE[0]}" ]]; then
  install_node_dependencies "$@"
fi

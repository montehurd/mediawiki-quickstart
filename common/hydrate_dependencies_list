#!/bin/bash

set -eu

# Resolves component dependencies recursively and outputs a complete,
# deduplicated installation order with each component appearing only
# after all its dependencies. This flattened list is better than
# having the installer itself recurse
#
# A dependency cycle ends at the first component it revisits, which is
# listed after the rest of its cycle
#
# Already installed components are also filtered out of results

source "/var/local/common/utility.sh"

_get_dependencies() {
  local component_path="$1"
  local dependencies_file="/var/local/${component_path}/dependencies.yml"
  if [ -f "$dependencies_file" ]; then
    _yq '.[]' "$(cat "$dependencies_file")"
  fi
}

RESULT=()
VISITED=()

_is_visited() {
  local component="$1"
  for item in "${VISITED[@]}"; do
    if [ "$item" = "$component" ]; then
      return 0
    fi
  done
  return 1
}

_process_component() {
  local component="$1"
  # Marked before recursing so a dependency cycle ends at the repeat visit
  _is_visited "$component" && return
  VISITED+=("$component")
  local deps
  deps=$(_get_dependencies "$component")
  if [ -n "$deps" ]; then
    for dep in $deps; do
      _process_component "$dep"
    done
  fi
  RESULT+=("$component")
}

_hydrate_dependencies_list() {
  RESULT=()
  VISITED=()
  for component in "$@"; do
    _process_component "$component"
  done
  echo "${RESULT[@]}"
}

if [[ "$0" == "${BASH_SOURCE[0]}" ]]; then
  COMPONENTS=$(_hydrate_dependencies_list "$@")
  UNINSTALLED_COMPONENTS=$(php /var/local/installer/filterOutInstalledComponents.php --components "$COMPONENTS")
  echo "$UNINSTALLED_COMPONENTS"
fi

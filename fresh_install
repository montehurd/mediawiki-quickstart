#!/bin/bash

# -e arrives implicitly with the first sourced file below, which makes error
# handling depend on source order. State it here instead
set -eu

source "./config"
source "./common/utility.sh"
source "./docker.sh"
source "./remove"
source "./prepare"
source "./start"
source "./import_page_xml"

fresh_install() {
  verify_compose_version 2 1 1 || return 1
  verify_docker_group || return 1
  print_force_mode_notification_if_necessary
  if ! confirm_action "Are you sure you want to do a fresh install"; then
    return
  fi
  remove
  prepare
  start
  if [[ "${SKIP_PAGE_IMPORT:-0}" != "1" ]]; then
    import_page_xml "/tmp/page-xml"
  fi
}

if [[ "$0" == "${BASH_SOURCE[0]}" ]]; then
  fresh_install_start_time=$(date +%s)
  fresh_install "$@"
  print_duration_since_start "$fresh_install_start_time" "\n\033[32m⏲\033[0m Total duration: %02d:%02d\n"
fi
